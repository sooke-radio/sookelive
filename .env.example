# payload
# DATABASE_URI=mongodb://127.0.0.1:27017/sl-p3 # optional - use for external db
PAYLOAD_SECRET=SECRET_HERE
CRON_SECRET=SECRET_HERE

# public
# NEXT_PUBLIC_SERVER_URL=http://localhost:3000 - use reverse proxy and docker network instead
NEXT_PUBLIC_STREAM_DISABLED=true
NEXT_PUBLIC_SITE_ENV=dev

# azuracast stream & api
AZURACAST_URL=
AZURACAST_STATION_ID=
AZURACAST_KEY=SECRET_HERE

# mailgun smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# wasabi s3 - episode audio. Uncomment with the stg-user credentials to store
# uploads in the stg bucket. Left unset, episode audio falls back to local disk
# in development ONLY - production builds/startup throw if any of these are
# missing (see src/payload.config.ts). Use the stg bucket, never srs-web-audio (prd).
# S3_BUCKET=srs-web-audio-stg
# S3_REGION=ca-central-1
# S3_ENDPOINT=https://s3.ca-central-1.wasabisys.com
# S3_ACCESS_KEY_ID=SECRET_HERE
# S3_SECRET_ACCESS_KEY=SECRET_HERE
