# DON'T PUT SECRETS HERE!!!

# public
NEXT_PUBLIC_SERVER_URL=https://sooke.live
NEXT_PUBLIC_STREAM_DISABLED=false
NEXT_PUBLIC_SITE_ENV=prd

# azuracast stream
NEXT_PUBLIC_AZURACAST_URL=https://stream.sooke.live
NEXT_PUBLIC_AZURACAST_STATION_ID=sookelive

# mailgun
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@mailer.sookeradio.ca

# enable autoRun jobs
ENABLE_JOBS=true

# wasabi s3 (episode audio)
S3_BUCKET=srs-web-audio
S3_REGION=ca-central-1
S3_ENDPOINT=https://s3.ca-central-1.wasabisys.com
S3_PUBLIC_URL=https://s3.ca-central-1.wasabisys.com/srs-web-audio
S3_PREFIX=episode-audio

# secrets added in github action
