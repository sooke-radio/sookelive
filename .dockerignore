# Keep server-local and generated files out of the build context.
# NOTE: .env must NOT be listed - the build stage's COPY . . relies on it
# for NEXT_PUBLIC_* values at `next build` time.
.git
node_modules
.next
db
Caddyfile
tmp
coverage
# Not part of the app build. deploy.yml's rsync excludes these but doesn't
# --delete, so copies left on the server from older deploys would otherwise
# reach `next build`'s type check (tsconfig includes **/*.ts).
tests
.claude
